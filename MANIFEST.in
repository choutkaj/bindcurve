include README.md
include LICENSE
include CITATION.cff
include architecture.md
include data_formats.md
include .python-version

recursive-include bindcurve *.py
recursive-include tests *.py

prune .github
prune algebra
prune assets
prune docs
prune docs_legacy
prune logo
prune quarto_website
prune tutorials

# Keep the inputs required by the tests shipped in the source distribution.
recursive-include docs/api *.md
recursive-include docs/tutorials/data *.csv

prune __pycache__
prune .pytest_cache
prune .ruff_cache
prune .uv-cache
prune .venv
prune .venv-smoke

global-exclude *.py[cod]
global-exclude *.ipynb
global-exclude .DS_Store
global-exclude *.svg
global-exclude *.png
global-exclude *.pptx
global-exclude *.xlsx
